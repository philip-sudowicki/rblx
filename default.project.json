{
  "name": "DeepHaul",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "ReplicatedFirst": {
      "Loading": {
        "$path": "src/first"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "CameraMaxZoomDistance": 32,
        "CameraMinZoomDistance": 6,
        "CharacterWalkSpeed": 20,
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 96,
        "StreamingTargetRadius": 640,
        "FallenPartsDestroyHeight": -5000,
        "Gravity": 196.2
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "Brightness": 2.2,
        "ClockTime": 13.5,
        "GlobalShadows": true,
        "FogStart": 0,
        "FogEnd": 2500,
        "FogColor": [0.62, 0.8, 0.92],
        "Ambient": [0.35, 0.4, 0.45],
        "OutdoorAmbient": [0.55, 0.6, 0.65]
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 2
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },

    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    }
  }
}
