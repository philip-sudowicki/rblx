local byId: { [string]: Skin } = {}
local list: { Skin } = {}
for index, def in defs do
	local skin: Skin = table.clone(def) :: any
	skin.order = index
	table.insert(list, skin)
	byId[skin.id] = skin
end

return {
	list = list,
	byId = byId,
	default = "Default",
}
