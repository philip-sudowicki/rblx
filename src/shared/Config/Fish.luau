--!strict
-- Every fish in DEEP HAUL.
--
-- zone     : zone id where it spawns. Event exclusives use zone = nil (see `zones` / `event`).
-- rarity   : rarity id (Config/Rarities)
-- value    : base coin value before weight / mutation / Colossal multipliers.
--            Event exclusives multiply `value` by the Zone.valueScale of the zone they're caught in.
-- weight   : { min, max } kilograms
-- model    : ModelBuilder recipe. shape = Classic | Slim | Tall | Flat | Eel | Puffer | Jelly |
--            Angler | Shark | Squid | Seahorse | Crab | Whale | Crystal | Duck
--            length = model length in studs at scale 1. glow = bioluminescent (visible in the dark).
-- event    : event id for event-exclusive fish (only spawn while that event is active)
-- zones    : optional list of zone indices an event fish may appear in (default: any zone)

export type FishModel = {
	shape: string,
	length: number,
	primary: Color3,
	secondary: Color3,
	pattern: string?, -- "stripes" | "spots" | "belly" | "none"
	glow: boolean?,
	neon: boolean?,
	hat: boolean?,
}

export type FishDef = {
	id: string,
	name: string,
	zone: string?,
	rarity: string,
	value: number,
	weight: { number },
	desc: string,
	model: FishModel,
	event: string?,
	zones: { number }?,
}

export type Fish = FishDef & { order: number }

