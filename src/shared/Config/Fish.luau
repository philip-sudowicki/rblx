local byId: { [string]: Fish } = {}
local byZone: { [string]: { Fish } } = {}
local byEvent: { [string]: { Fish } } = {}
local list: { Fish } = {}
for index, def in defs do
	local fish: Fish = table.clone(def) :: any
	fish.order = index
	table.insert(list, fish)
	byId[fish.id] = fish
	if fish.zone then
		byZone[fish.zone] = byZone[fish.zone] or {}
		table.insert(byZone[fish.zone], fish)
	end
	if fish.event then
		byEvent[fish.event] = byEvent[fish.event] or {}
		table.insert(byEvent[fish.event], fish)
	end
end

return {
	list = list,
	byId = byId,
	byZone = byZone,
	byEvent = byEvent,
}
