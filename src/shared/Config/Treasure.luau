local byId: { [string]: Treasure } = {}
local byZone: { [string]: { Treasure } } = {}
local byEvent: { [string]: { Treasure } } = {}
local list: { Treasure } = {}
for index, def in defs do
	local treasure: Treasure = table.clone(def) :: any
	treasure.order = index
	table.insert(list, treasure)
	byId[treasure.id] = treasure
	if treasure.zone then
		byZone[treasure.zone] = byZone[treasure.zone] or {}
		table.insert(byZone[treasure.zone], treasure)
	end
	if treasure.event then
		byEvent[treasure.event] = byEvent[treasure.event] or {}
		table.insert(byEvent[treasure.event], treasure)
	end
end

return {
	list = list,
	byId = byId,
	byZone = byZone,
	byEvent = byEvent,
}
