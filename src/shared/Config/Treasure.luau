--!strict
-- Every treasure in DEEP HAUL. Treasure is separate from fish: it lies on floors and ledges and
-- is salvaged by holding Action. Value = value × condition multiplier.
--
-- category : Config/TreasureCategories id
-- clawTier : optional override; default is the rarity's clawTier
-- cursed   : extra oxygen drain per carried item (0.2 = +20% drain while in cargo)
-- model    : ModelBuilder treasure recipe. shape = Coin | CoinPile | Bar | Chest | Ring | Crown |
--            Gem | Shard | Idol | Statue | Tablet | Obelisk | Mask | Anchor | Compass | Sextant |
--            Bell | Porthole | Figurehead | Cannonball | Goblet | Lyre | Scepter | Comb | Lantern |
--            Spyglass | Book | Device | Coil | Orb | Cog
-- event    : event-exclusive (value multiplied by the zone's valueScale where found)

export type TreasureModel = {
	shape: string,
	primary: Color3,
	secondary: Color3,
	glow: boolean?,
	size: number?,
}

export type TreasureDef = {
	id: string,
	name: string,
	zone: string?,
	category: string,
	rarity: string,
	value: number,
	desc: string,
	model: TreasureModel,
	clawTier: number?,
	cursed: number?,
	event: string?,
	zones: { number }?,
}

export type Treasure = TreasureDef & { order: number }

