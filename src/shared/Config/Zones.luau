--!strict
-- Depth zones: geometry (studs), displayed depth (metres), lighting, pools and hazards.
--
-- The world is one vertical shaft centred on (0, y, 0). Surface is y = 0 and y goes negative
-- downward. Each zone occupies [bottomY, topY]; its floor slab fills the lowest
-- `floorThickness` studs, with a hole (offset from the centre) leading to the next zone.
-- Displayed metres map linearly from the zone's stud band onto `meters`.

local rgb = Color3.fromRGB

export type ZoneLighting = {
	fogColor: Color3,
	fogStart: number,
	fogEnd: number, -- ignored when dark = true (light radius decides)
	ambient: Color3,
	outdoorAmbient: Color3,
	brightness: number,
	tint: Color3,
	saturation: number,
	contrast: number,
	ccBrightness: number,
	bloom: number,
}

-- Optional decoration palette. Terrain material colours are global per material, so zones that
-- share a material must give it the same colour (checked by tests/config.spec).
export type ZoneStyle = {
	kelp: Color3?, -- kelp base colour
	kelpHeight: number?, -- kelp height multiplier
	shaft: Color3?, -- light shaft colour
	glow: { Color3 }?, -- glowing coral colours
	crystals: { Color3 }?, -- crystal colours
}

export type Zone = {
	id: string,
	index: number,
	name: string,
	short: string,
	desc: string,
	hazard: string,
	color: Color3,
	topY: number,
	bottomY: number,
	radius: number,
	floorThickness: number,
	hole: { x: number, z: number, r: number }?,
	terraces: { { r: number, y: number } }?,
	meters: { number },
	materials: { floor: Enum.Material, wall: Enum.Material, accent: Enum.Material },
	materialColors: { floor: Color3, wall: Color3, accent: Color3 },
	lighting: ZoneLighting,
	dark: boolean,
	oxygenDrain: number, -- oxygen units per second
	rarityBonus: number, -- multiplies the chance of Uncommon+ tiers
	valueScale: number, -- scales event-exclusive item values and quest/daily rewards
	fishDensity: number, -- target fish within Game.Spawns.DensityRadius of each diver
	treasureDensity: number, -- target treasure within Game.Spawns.TreasureRadius of each diver
	predatorDensity: number,
	predators: { string },
	requiresRebirth: boolean,
	ambient: string, -- Sounds key
	music: string, -- Sounds key
	decor: { [string]: number },
	style: ZoneStyle,
}

